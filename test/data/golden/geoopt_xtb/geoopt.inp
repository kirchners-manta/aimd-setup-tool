&GLOBAL
  ALLTOALL_SGL YES
  FFTW_PLAN_TYPE PATIENT
  PREFERRED_FFT_LIBRARY FFTW
  PRINT_LEVEL LOW
  PROJECT geoopt_xtb_opt
  RUN_TYPE GEO_OPT
&END GLOBAL
&MOTION
  &GEO_OPT
    MAX_DR    0.001
    MAX_FORCE 0.00015
    MAX_ITER  200
    OPTIMIZER CG
    RMS_DR    0.0005
    RMS_FORCE 0.0001
    TYPE MINIMIZATION
  &END GEO_OPT
&END MOTION
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 400
      NGRIDS 4
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      EXTRAPOLATION_ORDER 4
      METHOD XTB
      &XTB
        CHECK_ATOMIC_CHARGES F
        DO_EWALD  T
        USE_HALOGEN_CORRECTION T
      &END XTB
    &END QS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 20
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        MAX_SCF 20
        EPS_SCF 1.0E-6
      &END OUTER_SCF
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
    &END CELL
    &KIND H
      BASIS_SET ORB DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-XTB-q1
    &END KIND
    &KIND O
      BASIS_SET ORB DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-XTB-q6
    &END KIND
    &TOPOLOGY
      COORD_FILE_NAME water.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
