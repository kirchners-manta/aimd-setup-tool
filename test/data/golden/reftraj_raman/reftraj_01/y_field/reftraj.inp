&GLOBAL
  ALLTOALL_SGL YES
  FFTW_PLAN_TYPE PATIENT
  PREFERRED_FFT_LIBRARY FFTW
  PRINT_LEVEL LOW
  PROJECT reftraj_raman_01_y
  RUN_TYPE MD
&END GLOBAL
&MOTION
  &MD
    COMVEL_TOL 1e-12
    ENSEMBLE REFTRAJ
    STEPS 10000
    TIMESTEP 0.5
    &REFTRAJ
      EVAL_ENERGY_FORCES
      FIRST_SNAPSHOT 1
      LAST_SNAPSHOT 79993
      STRIDE 8
      TRAJ_FILE_NAME water_traj.xyz
    &END REFTRAJ
  &END MD
  &PRINT
    &RESTART
      &EACH
        MD 1
      &END EACH
    &END RESTART
    &RESTART_HISTORY
      &EACH
        MD 500
      &END EACH
    &END RESTART_HISTORY
  &END PRINT
&END MOTION
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 400
      NGRIDS 4
      REL_CUTOFF 60
    &END MGRID
    &PERIODIC_EFIELD
      INTENSITY 0.005
      POLARISATION 0.0 1.0 0.0
    &END PERIODIC_EFIELD
    &QS
      EPS_DEFAULT 1e-12
      EXTRAPOLATION_ORDER 4
    &END QS
    &SCF
      EPS_SCF 1e-06
      MAX_SCF 20
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        MAX_SCF 20
        EPS_SCF 1e-06
      &END OUTER_SCF
    &END SCF
    &XC
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          TYPE DFTD3(BJ)
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
      &XC_FUNCTIONAL
        &PBE
          PARAMETRIZATION REVPBE
        &END PBE
      &END XC_FUNCTIONAL
      &XC_GRID
        XC_DERIV NN10_SMOOTH
        XC_SMOOTH_RHO NN10
      &END XC_GRID
    &END XC
    &PRINT
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
    &END CELL
    &KIND H
      BASIS_SET ORB DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET ORB DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &TOPOLOGY
      COORD_FILE_NAME water.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
