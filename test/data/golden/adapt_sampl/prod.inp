&GLOBAL
  ALLTOALL_SGL YES
  FFTW_PLAN_TYPE PATIENT
  PREFERRED_FFT_LIBRARY FFTW
  PRINT_LEVEL LOW
  PROJECT adapt_sampl_prod
  RUN_TYPE MD
&END GLOBAL
&MOTION
  &MD
    COMVEL_TOL 1.0E-12
    ENSEMBLE NVT
    STEPS 2
    TIMESTEP 0.5
    TEMPERATURE 350.0
    &THERMOSTAT
      REGION GLOBAL
      TYPE NOSE
      &NOSE
        TIMECON 100
      &END NOSE
    &END THERMOSTAT
  &END MD
  &PRINT
    &FORCES
      &EACH
        MD 1
      &END EACH
    &END FORCES
    &TRAJECTORY
      &EACH
        MD 1
      &END EACH
    &END TRAJECTORY
    &VELOCITIES
      &EACH
        MD 1
      &END EACH
    &END VELOCITIES
  &END PRINT
&END MOTION
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 400
      NGRIDS 4
      REL_CUTOFF 60
    &END MGRID
    &PRINT
      &E_DENSITY_BQB
        FILENAME =edens.bqb
        HISTORY 1
        &EACH
          MD 1
        &END EACH
      &END E_DENSITY_BQB
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-12
      EXTRAPOLATION_ORDER 4
    &END QS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 20
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        MAX_SCF 20
        EPS_SCF 1.0E-6
      &END OUTER_SCF
    &END SCF
    &XC
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          TYPE DFTD3(BJ)
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
      &XC_FUNCTIONAL
        &PBE
          PARAMETRIZATION REVPBE
        &END PBE
      &END XC_FUNCTIONAL
      &XC_GRID
        XC_DERIV NN10_SMOOTH
        XC_SMOOTH_RHO NN10
      &END XC_GRID
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
    &END CELL
    &KIND H
      BASIS_SET ORB DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET ORB DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &TOPOLOGY
      COORD_FILE_NAME water.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &VELOCITY
      1.0E-4 0.0 0.0
      0.0 1.0E-4 0.0
      0.0 0.0 1.0E-4
    &END VELOCITY
  &END SUBSYS
&END FORCE_EVAL
